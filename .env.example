# ─── kimiSec 环境变量模板 ─────────────────────────────────────────────────
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# LLM 认证（推荐）
ZDLL_LLM_API_KEY=sk-your-api-key-here
ZDLL_LLM_PROVIDER=anthropic          # anthropic | openai
ZDLL_LLM_BASE_URL=https://api.kimi.com/coding
ZDLL_LLM_MODEL_NAME=kimi-for-coding

# 旧版兼容（仅 API key 会被读取，base_url/model 不会被读取）
# KIMI_API_KEY=sk-your-api-key-here

# OSV-Scanner 路径（可选，留空则自动在 PATH / ./bin/ 中查找）
# OSV_SCANNER_PATH=/usr/local/bin/osv-scanner
