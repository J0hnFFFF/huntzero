# ─── kimiSec 环境变量模板 ─────────────────────────────────────────────────
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# Kimi API 认证
KIMI_API_KEY=sk-your-api-key-here
KIMI_BASE_URL=https://api.kimi.com/coding/v1

# Redis (集群模式)
KIMI_REDIS_URL=redis://redis:6379/0

# OSV-Scanner 路径（可选，留空则自动在 PATH / ./bin/ 中查找）
# OSV_SCANNER_PATH=/usr/local/bin/osv-scanner
